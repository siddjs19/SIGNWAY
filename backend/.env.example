PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/signbridge
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Optional. Conversations return an explicit error if this is not configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional. Recognition remains unavailable until both Jestally values are configured.
JESTALLY_API_URL=https://6n5ur96sk6.execute-api.ap-south-1.amazonaws.com/prod/recognize
JESTALLY_API_KEY=
JESTALLY_API_TIMEOUT_MS=10000

# Experimental: authenticated SignBridge requests are proxied to this public demo.
ISL_BRIDGE_API_TIMEOUT_MS=15000

# MST Coral Testnet credential registry. The issuer key must remain backend-only.
MST_RPC_URL=https://coralrpc.mstblockchain.com/
MST_CHAIN_ID=54635
MST_EXPLORER_URL=https://coral.mstscan.com/
MST_CREDENTIAL_CONTRACT_ADDRESS=
MST_ISSUER_PRIVATE_KEY=
# Comma-separated account emails allowed to invoke issuer-only revocation.
MST_CREDENTIAL_REVOKER_EMAILS=
# Optional: request timeout for MST RPC operations in milliseconds.
MST_RPC_TIMEOUT_MS=15000